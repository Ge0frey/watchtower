# ---- chains
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
CC3_CHAIN_ID=102031
MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/<key>
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/<key>
# Optional second endpoint per chain. The worker races both and takes the first good answer, so one
# provider going down does not stall the scanners. Tested working against our actual query shapes:
MAINNET_RPC_FALLBACK=https://eth.drpc.org
SEPOLIA_RPC_FALLBACK=https://sepolia.gateway.tenderly.co

# ---- attestcoin
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
BLOCK_PROVER_PRECOMPILE=0x0000000000000000000000000000000000000FD2
CHAIN_INFO_PRECOMPILE=0x0000000000000000000000000000000000000fd3
CHAIN_KEY_SEPOLIA=1
CHAIN_KEY_MAINNET=3
# NOTE: no EVM_DECODER address needed - EvmV1Decoder is an internal library and inlines.

# ---- keys (never commit real values)
PROSECUTOR_PK=
DEPLOYER_PK=
SEPOLIA_DEMO_PK=

# ---- deployments (filled by script/DeployCreditcoin.s.sol)
SUBJECT_REGISTRY=
UNDERWRITING_VAULT=
WATCHTOWER_CORE=
RULE_INTRABLOCK=
RULE_RESERVE=
RULE_FEED=
RULE_FAILEDTX=
DEMO_BRIDGE_SEPOLIA=
DEMO_TOKEN_SEPOLIA=

# ---- infra
DATABASE_URL=postgres://watchtower:watchtower@localhost:5432/watchtower
WORKER_API_URL=http://localhost:8080
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8080

# ---- demo source contracts (filled before DeployCreditcoin)
DEMO_POOL_MAINNET=              # Uniswap V2 pool watched by IntraBlockExtraction
DEMO_AGGREGATOR_MAINNET=        # Chainlink ETH/USD AGGREGATOR (not the proxy)
DEMO_FAILED_TX_WATCH=           # address whose failed transactions are covered
FEED_ANCHOR_HEIGHT=             # mainnet height the price stream starts from
BRIDGE_ANCHOR_HEIGHT=           # sepolia height DemoBridge was deployed at

# ---- subject ids (printed by DeployCreditcoin)
SUBJECT_POOL=
SUBJECT_BRIDGE=
SUBJECT_FEED=
SUBJECT_ACCOUNT=

# ---- seeding
# Every SeedDemo amount is proportional to this. 10000 = the full 8.3 CTC budget.
SEED_SCALE_BPS=10000

# ---- worker
WORKER_PORT=8080
SUBMIT_ENABLED=true
PROSECUTOR_BOND_WEI=100000000000000000
SCAN_CONFIRMATIONS=8
# Largest block range one eth_getLogs may span. Alchemy's free tier hard-caps this at 10 and rejects
# wider queries outright, so every scan is sliced to fit. Raise it if your provider allows more.
LOG_RANGE=10
INDEXER_POLL_MS=10000

# ---- dashboard (must be NEXT_PUBLIC_ to reach the browser)
NEXT_PUBLIC_WATCHTOWER_CORE=
NEXT_PUBLIC_SUBJECT_REGISTRY=
NEXT_PUBLIC_UNDERWRITING_VAULT=
